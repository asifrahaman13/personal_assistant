{
    "venvPath": ".",
    "venv": ".venv",
    "pythonVersion": "3.12",
    "pythonPlatform": "Linux",
    "executionEnvironments": [
      {
        "root": ".",
        "pythonVersion": "3.12",
        "pythonPlatform": "Linux",
        "extraPaths": [
          "src"
        ]
      }
    ],
    "include": [
      "src",
      "tests"
    ],
    "exclude": [
      "**/node_modules",
      "**/__pycache__",
      ".venv",
      ".ruff_cache",
      ".mypy_cache"
    ],
    "reportMissingImports": "warning",
    "reportMissingTypeStubs": false,
    "typeCheckingMode": "basic"
  }